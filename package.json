{
  "name": "kachbot",
  "version": "1.0.0",
  "main": "bot/bot.js",
  "scripts": {
    "build": "tsc",
    "start": "pip install yt-dlp --break-system-packages && node dist/bot.js",
    "dev": "ts-node src/bot.ts",
    "postinstall": "node -e \"if (process.platform !== 'win32') { require('child_process').execSync('npm rebuild sqlite3 --build-from-source', { stdio: 'inherit' }); }\""
  },
  "dependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.5.4",
    "@types/node-telegram-bot-api": "^0.64.10",
    "@types/pg": "^8.20.0",
    "@types/sqlite3": "^3.1.11",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "fluent-ffmpeg": "^2.1.3",
    "node-telegram-bot-api": "^0.66.0",
    "pg": "^8.21.0",
    "sqlite3": "^6.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^4.9.5"
  },
  "devDependencies": {
    "@types/fluent-ffmpeg": "^2.1.28"
  }
}